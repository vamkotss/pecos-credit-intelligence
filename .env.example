# Copy to .env and fill in. .env is gitignored and must never be committed.
#   PowerShell:  Copy-Item .env.example .env

# --- Secrets -----------------------------------------------------------
OPENAI_API_KEY=sk-replace-me

# --- Reproducibility ---------------------------------------------------
PC_SEED=20260804
# PC_CI_MODE=1 shrinks the corpus and eval set for fast, deterministic runs.
# It keeps every defect class -- only volume is reduced.
PC_CI_MODE=0

# --- Paths (leave unset to use the repo's own folders) -----------------
# PC_DATA_DIR=
# PC_REPORTS_DIR=
# PC_EVALS_DIR=

# --- Postgres + pgvector (port 5435 avoids P2's 5433 and P4's 5434) ----
PC_PG_HOST=localhost
PC_PG_PORT=5435
PC_PG_DB=pecos
PC_PG_USER=pecos
PC_PG_PASSWORD=pecos_local_dev

# --- Models ------------------------------------------------------------
PC_LLM_MODEL_SMALL=gpt-4o-mini
PC_LLM_MODEL_LARGE=gpt-4o
PC_EMBED_MODEL=text-embedding-3-small
PC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PC_TEMPERATURE=0.0

# --- Retrieval ---------------------------------------------------------
PC_CHUNK_TARGET_TOKENS=512
PC_CHUNK_OVERLAP_TOKENS=64
PC_RETRIEVE_K_DENSE=20
PC_RETRIEVE_K_SPARSE=20
PC_RERANK_TOP_N=6

# --- Cost guardrail ----------------------------------------------------
PC_MAX_COST_USD_PER_MEMO=0.50

# --- Milestone 6: answering and evaluation ---
# Models used by --generator anthropic and --judge anthropic. Both default to
# Haiku, which is cheap enough to run the full 127-question eval for cents.
# Override to compare a stronger model on the same gold set.
PC_ANSWER_MODEL=claude-haiku-4-5-20251001
PC_JUDGE_MODEL=claude-haiku-4-5-20251001

# The API key is NOT set here. It is read from the environment and never
# written to a tracked file. Set it with:
#     setx ANTHROPIC_API_KEY "sk-ant-..."
# ANTHROPIC_API_KEY is deliberately absent from this file.
